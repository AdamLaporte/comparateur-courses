# Modèle de configuration : copier en .env (jamais commité).
# Toutes les variables ont une valeur par défaut : le site marche sans .env, avec des données fictives.

# Source de prix par enseigne :
#   fictive  : données fictives, toujours marquées (défaut)
#   api      : Intermarché, API officielle
#   collecte : Carrefour, E.Leclerc Drive, Courses U, collecte en direct
SOURCE_CARREFOUR=fictive
SOURCE_INTERMARCHE=fictive
SOURCE_COURSESU=fictive
SOURCE_LECLERC=fictive

# Clé de l'API Intermarché : vide tant que la demande n'est pas approuvée.
# Vide = aucune requête vers l'API, repli direct (cache, Open Prices, « prix indisponible »).
INTERMARCHE_API_KEY=

# Magasins interrogés
RAYON_KM=10
MAX_MAGASINS_PAR_ENSEIGNE=2

# Collecte
TIMEOUT_ENSEIGNE_S=6
TIMEOUT_REQUETE_S=5
CONCURRENCE_PAR_ENSEIGNE=3
CACHE_TTL_MIN=360
# Délai aléatoire de la source fictive (secondes), pour voir les prix arriver un par un
DELAI_FICTIF_MAX_S=0.8

# Référentiel produits : open_food_facts (défaut) ou fictive (catalogue fictif, sans réseau)
SOURCE_PRODUITS=open_food_facts
# Open Prices en secours quand une enseigne ne répond pas (false = aucune requête)
OPEN_PRICES_ACTIF=true

# Application
SECRET_KEY=a-changer-pour-la-demo
DB_PATH=data/app.db
