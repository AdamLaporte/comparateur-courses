{
  "manifest_version": 3,
  "name": "Prix – Super U Bruz",
  "version": "1.3.0",
  "description": "Relève les prix des fiches produits ouvertes et exporte un CSV local.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms",
    "webRequest"
  ],
  "host_permissions": ["http://127.0.0.1/*", "https://*.coursesu.com/*"],
  "background": {"service_worker": "collecteur.js", "type": "module"},
  "action": {
    "default_popup": "popup.html",
    "default_title": "Prix – Super U Bruz"
  }
}
