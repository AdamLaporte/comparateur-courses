{
  "manifest_version": 3,
  "name": "Prix – Intermarché",
  "version": "1.6.0",
  "description": "Relève les prix des fiches produits ouvertes et exporte un CSV local.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms",
    "webRequest"
  ],
  "host_permissions": ["http://127.0.0.1/*", "https://*.intermarche.com/*", "https://*.intermarche.fr/*"],
  "optional_host_permissions": ["https://*.ts.net/*"],
  "background": {"service_worker": "collecteur.js", "type": "module"},
  "action": {
    "default_popup": "popup.html",
    "default_title": "Prix – Intermarché"
  }
}
